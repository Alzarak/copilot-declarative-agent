{
  "description": "Remind Claude to validate the appPackage after editing its files",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/apppackage_reminder.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
